---
// src/components/Row.astro
interface Props {
  col1: string;
  col2Top: string;
  col2Bottom: string;
  col3: string;
}
const { col1, col2Top, col2Bottom, col3 } = Astro.props;
---
<div class="grid gap-[2vw] pt-[8vw] px-[8vw] py-[8vw] grid-cols-1 sm:gap-[4vw] sm:grid-cols-[0.4fr_1fr_1fr]">

  <div class="font-sans text-[4vw] sm:text-[1.8vw] text-black">{col1}</div>

  <div class="flex flex-col sm:gap-[0.5vw] gap-[0.5vw]">
    <span class="font-sans text-[4vw] sm:text-[1.8vw] text-left text-black">{col2Top}</span>
    <span class="text-[7vw] sm:text-[3.5vw] text-[#160066]">{col2Bottom}</span>
  </div>

  <div class="text-[4vw] sm:text-[1.8vw] text-[#414141]">{col3}</div>
</div>