---
import Layout from "../layouts/Layout.astro";
import Row2 from "../components/row2.astro";
import Row3 from "../components/row3.astro";
import Explorer from "../assets/explorer.png";
import Button from "../components/button.astro";
import ModeChange from "../components/mode-change.astro";
---

<Layout title="Home">
  <!-- Section 1: grows with its content -->
<!-- <div class="lg:border-x-[15vw] lg:border-[#efd0b4] dark:border-[#1a3721] lg:w-full"> -->

  <div class="relative bg-[#ffffff] dark:bg-[#000000] ">
	<ModeChange />
    <div class="flex flex-col items-center pt-12 pb-16">
	<h1 class="mt-25  px-[10vw] text-[23px] text-left text-[#222222] dark:text-[#cccccc] lg:max-w-[70vw] lg:mx-auto lg:px-[8vw]">
        <!-- Welcome. Welcome.<br /> -->
		This is Dora's personal website. In here you will find information about me, my experience, projects, as well as my thoughts and ideas. 
		Feel free to explore and get in touch!
      </h1>
	<div class="flex flex-col items-center gap-[5vw]
			sm:flex-row sm:justify-between sm:items-center pt-10 ">
		<Button link="mailto:quackium@proton.me" text="Email" newTab />
		<Button link="https://www.linkedin.com/in/teodora-piel-199a18428" text="LinkedIn" newTab />		
		
		
	<!-- </div> -->

	<!-- <h2 class="w-full px-[10vw] mt-10 text-[23px] text-left left-0 text-[#222222] dark:text-[#cccccc] lg:max-w-[70vw] lg:mx-auto lg:px-[8vw]">
        You want more Information? 
		You can find my CV and GitHub profile below. 
      </h2> -->

	<!-- <div class="flex flex-col items-center gap-[5vw]
			sm:flex-row sm:justify-between sm:items-center pt-10 "> -->
	  	<Button link="https://github.com/AuroraXP" text="GitHub" newTab />
		<Button link="documents/TeodoraPielCV.pdf" text="CV" newTab />
	</div>

</div>



  <!-- Section 2: starts immediately after -->
	<div class="relative py-[10vw] bg-[#fff4e6] dark:bg-[#222222]">
		<h2 class=" font-sans mt-3 text-[35px] px-[10vw] pl-[8vw]  text-[#160066] dark:text-[#ffffff] translate-y-[-4vw] lg:max-w-[70vw] lg:mx-auto lg:px-[8vw]
	">
		01 Academic Career
		</h2>	
		
		<Row2 
		col1="2024 - 2026" 
		col2Top="RWTH Aachen University" 
		col2Bottom="Master of Science in Chemistry" 
		/>
		
		<Row2
		col1="2020 - 2024" 
		col2Top="RWTH Aachen University" 
		col2Bottom="Bachelor of Science in Chemistry" 
		/>
	</div>	
		<!-- Section 3: starts immediately after -->
	<div class="relative min-h-screen bg-[#fff4e6] dark:bg-[#222222]">
		<h2 class=" font-sans text-[35px] px-[10vw] pl-[8vw]  text-[#160066] dark:text-[#ffffff] translate-y-[-5vw] lg:max-w-[70vw] lg:mx-auto lg:px-[8vw]">
		02 Work Experience
		</h2>
		<Row3
		col1="November 2025 - Mai 2026" 
		col2Top="RWTH Aachen University" 
		col2Bottom="Master Thesis" 
		col3="Automatization of crystallographic workflows using machine learning tools. 
			Early Plugin development for the Olex2 Crystallography Software using Python." 
		/>
		<Row3 
		col1="April 2025 - August 2025" 
		col2Top="RWTH Aachen University" 
		col2Bottom="Research Internship" 
		col3="Benchmarking of a novel Partitioning Scheme for Crystal Refinement." 
		/>
		<Row3 
		col1="March 2024 - October 2024" 
		col2Top="RWTH Aachen University" 
		col2Bottom="Research Assistant" 
		col3="Coordination Chemistry & Ligand Synthesis." 
		/>
		<Row3 
		col1="June 2024 - September 2024" 
		col2Top="RWTH Aachen University" 
		col2Bottom="Research Internship" 
		col3="Solid-State Chemistry & Single-Crystal Synthesis." 
		/>
		<Row3 
		col1="November 2023 - February 2024" 
		col2Top="RWTH Aachen University" 
		col2Bottom="Bachelor Thesis" 
		col3="Synthesis and Characterization of Complexes for PET Scan Application." 
		/>
		<Row3 
		col1="April 2023 - June 2023" 
		col2Top="RWTH Aachen University" 
		col2Bottom="Student Research Internship" 
		col3="Solid-State Chemistry & Single-Crystal Synthesis." 
		/>

	</div>
	<div class="relative bg-[#fff4e6] dark:bg-[#222222] pb-[5vw]">

		<img src={Explorer.src} alt="Explorer" class="relative lg:max-w-[70vw] lg:mx-auto lg:pt-[5vw] translate-y-[1vw]
				" />
	<!-- <h1 class="text-[4.5vw] sm:text-[4vw] px-[8vw] lg:text-[2vw] text-left text-[#ffffff] dark:text-[#222222] translate-y-[-20vw]">
			Master of Science in Chemistry
		</h1> -->
	<div class="relative py-[0.8vw] lg:py-[0.8vw] mt-[5vw] sm:mt-[-20vw] lg:mt-[-10vw]
				bg-[#fff4e6] dark:bg-[#222222] dark:border-y-black sm:border-y-4
				lg:max-w-[70vw] lg:mx-auto px-[8vw]">

	<div class="flex flex-col items-center gap-2
				sm:flex-row sm:justify-between sm:items-center">
		<Button link="/behind-the-scenes" text="Behind the Scenes" />
		<Button link="/explore-reasoning" text="Explore Reasoning" />
	</div>
  </div>
</div>
</div>
</Layout>
