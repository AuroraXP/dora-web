---
// src/components/FlipCard.astro

import { Image } from 'astro:assets';
import longVine from '../assets/long-vine.png';
import curvedVine from '../assets/curved-vine.png';

const {
  title,
  text,
  color = '#ffefe8',
  darkColor = '#1a1a1a',
  titleColor = '#160066',
  darkTitleColor = '#a2a9fc',
  textColor = '#414141',
  darkTextColor = '#cccccc',
  backColor = '#fadebe',
  darkBackColor = '#1a1a24',
  backTextColor = '#222222',
  darkBackTextColor = '#cccccc',
  hasVine = false,
  hasCurvedVine = false,
  size = 'w-[280px]',
} = Astro.props;
---

<div
  class={`flip-card group @container relative aspect-square cursor-pointer perspective-[1000px] ${size}`}
  style={`
    --card-bg: ${color};
    --card-bg-dark: ${darkColor};
    --card-title: ${titleColor};
    --card-title-dark: ${darkTitleColor};
    --card-text: ${textColor};
    --card-text-dark: ${darkTextColor};
    --card-back-bg: ${backColor};
    --card-back-bg-dark: ${darkBackColor};
    --card-back-text: ${backTextColor};
    --card-back-text-dark: ${darkBackTextColor};
  `}> <!-- For most variables standard cosistency seems is the best design choice >> Keeping them for now just in case -->
  <div class="flip-inner relative h-full w-full transition-transform duration-500 transform-3d">

    <!-- FRONT -->
    <div
      class="absolute inset-0 flex flex-col items-center justify-center rounded-lg border border-black dark:border-[#ffffff] p-3 text-center shadow-xl  dark:shadow-black backface-hidden bg-(--card-bg) dark:bg-(--card-bg-dark) transform-3d">
      <h2 class="text-[23px] text-(--card-title) dark:text-(--card-title-dark)">{title}</h2>
      <p class="mt-1 text-[20px] text-(--card-text) dark:text-(--card-text-dark)">{text}</p>

      {hasVine && (
        <Image src={longVine} alt=""
          class="pointer-events-none absolute left-2 top-1/2 h-1/3 w-auto -translate-x-1/2 -translate-y-1/2 rotate-90 object-contain" />
      )}
      {hasCurvedVine && (
        <Image src={curvedVine} alt=""
          class="pointer-events-none absolute bottom-3 right-0 h-1/3 w-auto translate-x-1/4 translate-y-1/4 object-contain" />
      )}
    </div>

    <!-- BACK -->
    <div
      class="absolute inset-0 flex flex-col items-center justify-center rounded-lg border border-black dark:border-[#ffffff] p-3 text-center text-[18px] shadow-xl shadow-black/70 dark:shadow-black backface-hidden rotate-y-180 overflow-hidden bg-(--card-back-bg) dark:bg-(--card-back-bg-dark) text-(--card-back-text) dark:text-(--card-back-text-dark)">
      <slot name="back">
        <p class="text-[18px]">Nothing here yet…</p>
      </slot>
    </div>

  </div>
</div>

<script>
  document.querySelectorAll('.flip-card').forEach((card) => {
    card.addEventListener('click', () => {
      card.querySelector('.flip-inner')?.classList.toggle('flipped');
    });
  });
</script>

<style>
  .flipped {
    transform: rotateY(180deg);
  }
</style>