---
// src/components/row3.astro
interface Props {
  col1: string;
  col2Top: string;
  col2Bottom: string;
  col3: string;
}
const { col1, col2Top, col2Bottom, col3 } = Astro.props;
---
<div class="grid gap-[4vw] pt-[8vw] px-[8vw] py-[2vw] grid-cols-1 sm:gap-[6vw] lg:gap-[5vw] sm:grid-cols-[0.4fr_1fr_1fr] sm:px-[12vw] sm:py-[3vw]  lg:max-w-[70vw] lg:mx-auto lg:px-[8vw]
            ">

  <div class="font-sans text-[20px] text-black dark:text-[#cccccc]">{col1}</div>

  <div class="flex flex-col sm:gap-[0.5vw] gap-[0.5vw]">
    <span class="font-sans text-[20px] text-left text-black dark:text-[#cccccc]">{col2Top}</span>
    <span class="text-[30px] text-[#160066] dark:text-[#0da200]">{col2Bottom}</span>
  </div>
 
  <div class="text-[20px] text-[#414141] dark:text-[#cccccc]">{col3}</div>
</div>

