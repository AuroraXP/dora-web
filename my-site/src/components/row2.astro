---
// src/components/Row.astro
interface Props {
  col1: string;
  col2Top: string;
  col2Bottom: string;
}
const { col1, col2Top, col2Bottom} = Astro.props;
---
<div class="grid gap-[2vw] pt-[8vw] px-[8vw] py-[4vw] grid-cols-1 sm:gap-[4vw] sm:grid-cols-[0.4fr_1fr] sm:px-[12vw] sm:py-[3vw] lg:max-w-[70vw] lg:mx-auto lg:px-[8vw]">

  <div class="font-sans text-[4vw] sm:text-[1.8vw] lg:text-[20px] text-black">{col1}</div>

  <div class="flex flex-col sm:gap-[0.5vw] gap-[0.5vw]">
    <span class="font-sans text-[4vw] sm:text-[1.8vw] lg:text-[20px] text-left text-black">{col2Top}</span>
    <span class="text-[7vw] sm:text-[3.5vw] lg:text-[30px] text-[#160066]">{col2Bottom} </span>
  </div>
</div>

