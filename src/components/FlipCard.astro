---
// src/components/FlipCard.astro
import { Image } from "astro:assets";
import longVine from "../assets/long-vine.png";
import curvedVine from "../assets/curved-vine.png";

const {
	title,
	text,
	color = "#ffefe8",
	darkColor = "#1a1a1a",
	titleColor = "#160066",
	darkTitleColor = "#a2a9fc",
	textColor = "#414141",
	darkTextColor = "#cccccc",
	backColor = "#fadebe",
	darkBackColor = "#1a1a24",
	backTextColor = "#222222",
	darkBackTextColor = "#cccccc",
	hasVine = false,
	hasCurvedVine = false,
	size = "w-[280px]",
	backImage,
	backImages = [],
	backImageOpacity = 1,
} = Astro.props;

// accept either bare imported images or { image, caption } objects
const photos = backImages.slice(0, 6).map((e: { image: any; caption?: string }) =>
	"image" in e
		? { image: e.image, caption: e.caption }
		: { image: e, caption: undefined },
);
const hasCollage = photos.length > 0;
---

<div
  class={`flip-card group @container relative aspect-square cursor-pointer perspective-[1000px] ${size}`}
  style={`
    --card-bg: ${color};
    --card-bg-dark: ${darkColor};
    --card-title: ${titleColor};
    --card-title-dark: ${darkTitleColor};
    --card-text: ${textColor};
    --card-text-dark: ${darkTextColor};
    --card-back-bg: ${backColor};
    --card-back-bg-dark: ${darkBackColor};
    --card-back-text: ${backTextColor};
    --card-back-text-dark: ${darkBackTextColor};
  `}>
  <div class="flip-inner relative h-full w-full transition-transform duration-500 transform-3d shadow-xl dark:shadow-black hover:shadow-black/40 rounded-lg">

    <!-- FRONT -->
    <div
      class="absolute inset-0 flex flex-col items-center justify-center rounded-lg border border-black dark:border-[#ffffff] p-3 text-center backface-hidden overflow-hidden bg-(--card-bg) dark:bg-(--card-bg-dark) transform-3d">

      <h2 class="relative z-10 text-[23px] text-(--card-title) dark:text-(--card-title-dark)">{title}</h2>
      <p class="relative z-10 mt-1 text-[20px] text-(--card-text) dark:text-(--card-text-dark)">{text}</p>

      {hasVine && (
        <img src={longVine.src} alt=""
          class="pointer-events-none absolute left-2 top-1/2 z-10 h-1/3 w-auto -translate-x-1/2 -translate-y-1/2 rotate-90 object-contain" />
      )}
      {hasCurvedVine && (
        <img src={curvedVine.src} alt=""
          class="pointer-events-none absolute bottom-3 right-0 z-10 h-1/3 w-auto translate-x-1/4 translate-y-1/4 object-contain" />
      )}
    </div>

    <!-- BACK -->
    <div
      class={`absolute inset-0 flex flex-col items-center rounded-lg border border-black dark:border-[#ffffff] p-3 text-center text-[18px] backface-hidden rotate-y-180 overflow-hidden bg-(--card-back-bg) dark:bg-(--card-back-bg-dark) text-(--card-back-text) dark:text-(--card-back-text-dark) ${hasCollage ? "justify-start gap-[3cqw]" : "justify-center"}`}>

      {/* single full-bleed image */}
      {!hasCollage && backImage && (
        <img src={backImage.src} alt=""
          class="pointer-events-none absolute inset-0 h-full w-full object-cover"
          style={`opacity: ${backImageOpacity}`} />
      )}

      {/* photo-story collage */}
      {hasCollage && (
        <div class="collage w-full flex-1 min-h-0" data-count={photos.length}>
          {photos.map((p: { image: any; caption?: string }) => (
            <figure class="relative overflow-hidden rounded-md border border-black/10 dark:border-white/15">
              <img src={p.image.src} alt=""
                class="pointer-events-none h-full w-full object-cover"
                style={`opacity: ${backImageOpacity}`} />
              {p.caption && (
                <figcaption class="absolute inset-x-0 bottom-0 bg-black/45 px-1 py-0.5 text-[2.6cqw] leading-tight text-white">
                  {p.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      )}

      <div class={`relative z-10 ${hasCollage ? "shrink-0" : ""}`}>
        <slot name="back" />
      </div>
    </div>

  </div>
</div>

<script>
  document.querySelectorAll('.flip-card').forEach((card) => {
    card.addEventListener('click', () => {
      card.querySelector('.flip-inner')?.classList.toggle('flipped');
    });
  });
</script>

<style>
  .flipped {
    transform: rotateY(180deg);
  }

  .collage {
    display: grid;
    gap: 3cqw;
    grid-auto-flow: dense;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 1fr;
  }

  .collage[data-count="1"] { grid-template-columns: 1fr; }

  .collage[data-count="2"] { grid-template-columns: 1fr; grid-template-rows: 1fr 1fr; }

  /* one wide hero on top, two beneath */
  .collage[data-count="3"] { grid-template-rows: 1.2fr 1fr; }
  .collage[data-count="3"] > :first-child { grid-column: span 2; }

  .collage[data-count="4"] { grid-template-rows: 1fr 1fr; }

  /* two on top, three beneath */
  .collage[data-count="5"] {
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: 1fr 1fr;
  }
  .collage[data-count="5"] > :nth-child(-n + 2) { grid-column: span 3; }
  .collage[data-count="5"] > :nth-child(n + 3)  { grid-column: span 2; }

  .collage[data-count="6"] { grid-template-columns: repeat(3, 1fr); }
</style>